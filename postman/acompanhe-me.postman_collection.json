                "{{baseUrlHistorico}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Eventos de todas as solicitações do paciente, do mais recente para o mais antigo. O CPF pode ter máscara ou não. size vai de 1 a 100.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query HistoricoDoPaciente($cpf: String!, $page: Int, $size: Int) {\n  historicoDoPaciente(cpf: $cpf, page: $page, size: $size) {\n    solicitacaoId\n    tipoEvento\n    statusAtual\n    prioridadeAnterior\n    prioridadeNova\n    motivo\n    unidadeExecucaoNome\n    autor\n    dataEvento\n  }\n}",
