      "name": "ms-hist-solicitacoes (GraphQL)",
      "description": "Consultas ao histórico de eventos. O serviço grava um registro para cada evento publicado pelo ms-gestao-solicitacoes. Também é possível testar pela interface http://localhost:8083/graphiql.",
      "item": [
        {
          "name": "Linha do tempo de uma solicitação",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrlHistorico}}/graphql",
              "host": [
                "{{baseUrlHistorico}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Todos os eventos da solicitação, do mais antigo para o mais recente. Usa {{solicitacaoId}}.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query HistoricoDaSolicitacao($solicitacaoId: ID!) {\n  historicoDaSolicitacao(solicitacaoId: $solicitacaoId) {\n    tipoEvento\n    statusAtual\n    prioridadeAnterior\n    prioridadeNova\n    motivo\n    unidadeExecucaoNome\n    autor\n    dataEvento\n  }\n}",
                "variables": "{\n  \"solicitacaoId\": \"{{solicitacaoId}}\"\n}"
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sem erros GraphQL\", () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Histórico do paciente (paginado)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrlHistorico}}/graphql",
